{
  "skill_name": "writer",
  "description": "Composition tests for the writer router. The expected list is the smallest required module set; required_sections records conditional subsections that must be activated; forbidden entries guard against accidental Cartesian-product loading.",
  "cases": [
    {
      "id": "ordinary-paper-explanation",
      "prompt": "写一篇普通论文解读。",
      "expected_modules": ["types/explanation.md", "objects/paper.md", "formats/markdown.md", "common/writing.md", "common/evidence-and-citations.md", "reviewers/reader.md", "reviewers/source-reviewer.md", "checks/document.md"],
      "forbidden_modules": ["objects/repository.md", "lenses/derivation-analysis.md", "lenses/mechanism-analysis.md"]
    },
    {
      "id": "repository-explanation",
      "prompt": "根据官方仓库写一篇实现解读。",
      "expected_modules": ["types/explanation.md", "objects/repository.md", "formats/markdown.md", "common/writing.md", "common/evidence-and-citations.md", "reviewers/reader.md", "reviewers/source-reviewer.md", "checks/document.md"],
      "forbidden_modules": ["objects/paper.md"]
    },
    {
      "id": "teng-typst-explanation",
      "prompt": "用 Typst 解读 TENG 论文的推导与机制。",
      "expected_modules": ["types/explanation.md", "objects/paper.md", "lenses/derivation-analysis.md", "lenses/mechanism-analysis.md", "formats/typst.md", "common/writing.md", "common/evidence-and-citations.md", "reviewers/reader.md", "reviewers/source-reviewer.md", "checks/document.md"],
      "forbidden_modules": []
    },
    {
      "id": "teng-typst-scholia-explanation",
