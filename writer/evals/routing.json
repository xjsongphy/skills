      "expected_modules": ["types/explanation.md", "objects/paper.md", "lenses/derivation-analysis.md", "lenses/mechanism-analysis.md", "formats/typst.md", "format-integrations/scholia-typst.md", "common/writing.md", "common/evidence-and-citations.md", "reviewers/reader.md", "reviewers/source-reviewer.md", "checks/document.md"],
      "forbidden_modules": []
    },
    {
      "id": "gpu-paper-repository-explanation",
