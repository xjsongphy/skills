{
  "skill_name": "writer",
  "description": "Composition tests for the writer router. The expected list is the smallest required module set; forbidden entries guard against accidental Cartesian-product loading.",
  "cases": [
    {
      "id": "ordinary-paper-explanation",
      "prompt": "写一篇普通论文解读。",
      "expected_modules": ["types/explanation.md", "objects/paper.md"],
      "forbidden_modules": ["objects/repository.md", "lenses/derivation-analysis.md", "lenses/mechanism-analysis.md"]
    },
    {
      "id": "repository-explanation",
      "prompt": "根据官方仓库写一篇实现解读。",
      "expected_modules": ["types/explanation.md", "objects/repository.md"],
      "forbidden_modules": ["objects/paper.md"]
    },
    {
      "id": "teng-typst-explanation",
      "prompt": "用 Typst 解读 TENG 论文的推导与机制。",
      "expected_modules": ["types/explanation.md", "objects/paper.md", "lenses/derivation-analysis.md", "lenses/mechanism-analysis.md", "formats/typst.md"],
      "forbidden_modules": []
    },
    {
      "id": "teng-typst-scholia-explanation",
      "prompt": "用户指定使用 Scholia，用 Typst 解读 TENG 论文中需要编号和交叉引用的密集推导。",
      "expected_modules": ["types/explanation.md", "objects/paper.md", "lenses/derivation-analysis.md", "lenses/mechanism-analysis.md", "formats/typst.md", "format-integrations/scholia-typst.md"],
      "forbidden_modules": []
    },
    {
      "id": "gpu-paper-repository-explanation",
      "prompt": "同时解释 GPU kernel 论文和对应仓库实现。",
      "expected_modules": ["types/explanation.md", "objects/paper.md", "objects/repository.md", "domains/gpu-kernel.md", "lenses/mechanism-analysis.md"],
      "forbidden_modules": []
    },
    {
      "id": "ordinary-typst-report",
      "prompt": "写一份普通 Typst 报告。",
      "expected_modules": ["types/report.md", "formats/typst.md"],
      "forbidden_modules": ["format-integrations/scholia-typst.md", "objects/paper.md"]
    },
    {
      "id": "experiment-report",
      "prompt": "写一份物理实验报告。",
      "expected_modules": ["types/report.md", "type-addons/report-experiment.md"],
      "forbidden_modules": ["types/explanation.md", "objects/paper.md"]
    },
    {
      "id": "latex-textbook",
      "prompt": "写一章 LaTeX 数学教材。",
      "expected_modules": ["types/textbook.md", "formats/latex.md", "format-integrations/textbook-latex.md"],
      "forbidden_modules": ["types/report.md", "types/explanation.md"]
    }
  ]
}
