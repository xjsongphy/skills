      "expected_modules": ["types/explanation.md", "objects/paper.md", "objects/repository.md", "domains/gpu-kernel.md", "lenses/mechanism-analysis.md", "formats/markdown.md", "common/writing.md", "common/evidence-and-citations.md", "reviewers/reader.md", "reviewers/source-reviewer.md", "checks/document.md"],
      "forbidden_modules": []
